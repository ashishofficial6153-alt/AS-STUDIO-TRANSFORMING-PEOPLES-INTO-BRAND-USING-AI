}

.delve-btn-secondary { background: rgb(247, 244, 237); color: rgb(55, 65, 81); border: none; }

.delve-btn-secondary:hover { background: rgb(237, 232, 223); box-shadow: rgba(0, 0, 0, 0.08) 0px 2px 6px; }

@media (prefers-color-scheme: dark) {
  .delve-btn-secondary { background: rgb(51, 51, 51); color: rgb(209, 213, 219); border: none; }
  .delve-btn-secondary:hover { background: rgb(64, 64, 64); box-shadow: rgba(255, 255, 255, 0.05) 0px 2px 6px; }
}

.delve-btn-tertiary { background: transparent; color: rgb(107, 114, 128); border: 1px solid rgb(229, 231, 235); }

.delve-btn-tertiary:hover { background: rgb(249, 250, 251); color: rgb(55, 65, 81); border-color: rgb(156, 163, 175); box-shadow: rgba(0, 0, 0, 0.06) 0px 2px 6px; }

@media (prefers-color-scheme: dark) {
  .delve-btn-tertiary { background: transparent; color: rgb(209, 213, 219); border: 1px solid rgb(77, 77, 77); }
  .delve-btn-tertiary:hover { background: rgb(38, 38, 38); color: rgb(249, 250, 251); border-color: rgb(102, 102, 102); box-shadow: rgba(255, 255, 255, 0.04) 0px 2px 6px; }
}

.delve-settings-overlay { position: fixed; inset: 0px; background: rgba(0, 0, 0, 0); z-index: 1000000; display: none; backdrop-filter: none; overflow: hidden; touch-action: none; transition: background-color 0.3s, backdrop-filter 0.3s; }

.delve-settings-overlay.show { background: rgba(0, 0, 0, 0.4); backdrop-filter: blur(4px); }

@media (prefers-color-scheme: dark) {
  .delve-settings-overlay.show { background: rgba(0, 0, 0, 0.7); }
}

.delve-settings-modal { position: fixed; top: 0px; right: 0px; bottom: 0px; background: rgb(252, 251, 248); border-radius: 20px 0px 0px 20px; width: 450px; max-width: 90vw; display: flex; flex-direction: column; box-shadow: rgba(0, 0, 0, 0.1) -10px 0px 30px; transform: translateX(100%); transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1); overflow: hidden; }

.delve-settings-overlay.show .delve-settings-modal { transform: translateX(0px); }

@media (prefers-color-scheme: dark) {
  .delve-settings-modal { background: rgb(28, 28, 28); color: rgb(249, 250, 251); }
}

.delve-settings-content { flex: 1 1 0%; overflow: hidden auto; overscroll-behavior: contain; touch-action: pan-y; }

.delve-settings-close { position: absolute; top: 20px; left: 20px; background: transparent; border: none; cursor: pointer; padding: 8px; color: rgb(107, 114, 128); transition: color 0.2s; z-index: 10; }

.delve-settings-close:hover { color: rgb(27, 27, 27); }

@media (prefers-color-scheme: dark) {
  .delve-settings-close { color: rgb(156, 163, 175); }
  .delve-settings-close:hover { color: rgb(249, 250, 251); }

@media (prefers-color-scheme: dark) {
  .delve-settings-title { color: rgb(249, 250, 251); }
}

.delve-settings-subtitle { font-size: 0.9375rem; color: rgb(55, 65, 81); margin: 0px 0px 16px; line-height: 1.5; }

@media (prefers-color-scheme: dark) {
  .delve-settings-subtitle { color: rgb(229, 231, 235); }
}

.delve-settings-info { font-size: 0.875rem; color: rgb(107, 114, 128); margin: 0px; line-height: 1.5; }

@media (prefers-color-scheme: dark) {
  .delve-settings-info { color: rgb(156, 163, 175); }
}

.delve-settings-info a { color: inherit; text-decoration: underline; }

.delve-settings-info a:hover { text-decoration: underline; }

.delve-categories-container { padding: 0px 32px; }

.delve-category { }

.delve-category-header { display: flex; align-items: center; justify-content: space-between; padding: 20px 0px; cursor: default; }

.delve-category-header[data-expandable="true"] { cursor: pointer; }

.delve-category-left { display: flex; align-items: center; gap: 10px; }

.delve-category-icon { position: relative; width: 16px; height: 16px; color: rgb(107, 114, 128); user-select: none; }

@media (prefers-color-scheme: dark) {
  .delve-category-icon { color: rgb(156, 163, 175); }
}

.delve-category-icon svg { position: absolute; top: 0px; left: 0px; transition: opacity 0.2s, transform 0.2s; }

.delve-category-icon .icon-plus { opacity: 1; transform: scale(1); }

.delve-category-icon .icon-minus { opacity: 0; transform: scale(0.8); }

.delve-category.expanded .delve-category-icon .icon-plus { opacity: 0; transform: scale(0.8); }

.delve-category.expanded .delve-category-icon .icon-minus { opacity: 1; transform: scale(1); }

.delve-category-name { font-size: 1rem; font-weight: 500; color: rgb(27, 27, 27); }

@media (prefers-color-scheme: dark) {

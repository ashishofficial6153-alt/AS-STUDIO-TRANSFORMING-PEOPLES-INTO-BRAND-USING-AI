.prose-markdown, .prose.prose-markdown { background-color: transparent !important; }

.prose h1, .prose h2, .prose h3, .prose h4, .prose strong { font-weight: 480; }

#entriApp { pointer-events: auto !important; }

@keyframes heartbeat { 
  0% { transform: scale(1); }
  10% { transform: scale(1.07); }
  20% { transform: scale(1.02); }
  40% { transform: scale(1.02); }
  50% { transform: scale(1.06); }
  60% { transform: scale(1); }
}

@keyframes shake { 
  0%, 100% { transform: translateX(0px); }
  10%, 30%, 50%, 70%, 90% { transform: translateX(-2px); }
  20%, 40%, 60%, 80% { transform: translateX(2px); }
}


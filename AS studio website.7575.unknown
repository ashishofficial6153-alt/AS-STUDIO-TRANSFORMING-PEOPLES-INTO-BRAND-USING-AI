.delve-cookie-banner * { box-sizing: border-box; }

.delve-cookie-banner { position: fixed; bottom: 20px; right: 20px; transform: translateY(100px); background: rgb(252, 251, 248); border: 1px solid rgb(229, 231, 235); border-radius: 1.75rem; padding: 20px; max-width: 300px; width: calc(-40px + 100vw); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif; color: rgb(55, 65, 81); z-index: 999999; transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1); box-shadow: rgba(0, 0, 0, 0.12) 0px 10px 25px, rgba(0, 0, 0, 0.08) 0px 6px 12px; backdrop-filter: blur(8px); overflow: hidden; margin: 0px; line-height: 1.4; font-size: 0.875rem; text-align: left; vertical-align: baseline; direction: ltr; letter-spacing: normal; word-spacing: normal; }

@media (prefers-color-scheme: dark) {
  .delve-cookie-banner { background: rgb(28, 28, 28); border: 1px solid rgb(51, 51, 51); color: rgb(249, 250, 251); }
}

.delve-cookie-banner.show { transform: translateY(0px); }

.delve-cookie-banner.hiding { transform: translateY(120px); opacity: 0; pointer-events: none; visibility: hidden; }

.delve-banner-content { display: flex; flex-direction: column; gap: 16px; }

.delve-banner-header { display: flex; flex-direction: column; gap: 8px; }

.delve-banner-icon { display: none; }

.delve-banner-text { flex: 1 1 0%; }


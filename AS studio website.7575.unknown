@media (prefers-color-scheme: dark) {
  .delve-category-status { color: rgb(52, 211, 153); }
}

.delve-toggle { position: relative; width: 48px; height: 26px; background: rgb(229, 231, 235); border-radius: 13px; cursor: pointer; transition: 0.4s cubic-bezier(0.25, 0.8, 0.25, 1); flex-shrink: 0; }

@media (prefers-color-scheme: dark) {
  .delve-toggle { background: rgb(77, 77, 77); }
  .delve-toggle.enabled { background: rgb(255, 255, 255); }
  .delve-toggle.disabled-permanent { background: rgb(51, 51, 51); cursor: not-allowed; }
}

.delve-toggle.enabled { background: rgb(16, 185, 129); }

.delve-toggle.disabled-permanent { background: rgb(243, 244, 246); cursor: not-allowed; }

.delve-toggle-thumb { position: absolute; top: 3px; left: 3px; width: 20px; height: 20px; background: white; border-radius: 50%; transition: transform 0.4s cubic-bezier(0.25, 0.8, 0.25, 1), box-shadow 0.4s cubic-bezier(0.25, 0.8, 0.25, 1); box-shadow: rgba(0, 0, 0, 0.1) 0px 1px 3px; will-change: transform; }

@media (prefers-color-scheme: dark) {
  .delve-toggle.enabled .delve-toggle-thumb { background: rgb(28, 28, 28); }
}

.delve-toggle.enabled .delve-toggle-thumb { transform: translateX(22px); box-shadow: rgba(0, 0, 0, 0.15) 0px 2px 4px; }

.delve-category-content { max-height: 0px; overflow: hidden; transition: max-height 0.3s cubic-bezier(0.4, 0, 0.2, 1); }

.delve-category.expanded .delve-category-content { max-height: 200px; }

.delve-category-content-inner { opacity: 0; clip-path: inset(0px 0px 100%); transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1), clip-path 0.3s cubic-bezier(0.4, 0, 0.2, 1); }

.delve-category.expanded .delve-category-content-inner { opacity: 1; clip-path: inset(0px); }

.delve-category-description { font-size: 0.875rem; color: rgb(107, 114, 128); line-height: 1.5; margin: 0px 0px 20px; padding-left: 26px; }

@media (prefers-color-scheme: dark) {
  .delve-category-description { color: rgb(156, 163, 175); }
}

.delve-settings-actions { padding: 20px 32px 24px; display: flex; gap: 16px; justify-content: center; background: rgb(252, 251, 248); }

@media (prefers-color-scheme: dark) {
  .delve-settings-actions { background: rgb(28, 28, 28); }
}

.delve-settings-actions .delve-btn { flex: 1 1 0%; max-width: 250px; }

.delve-settings-footer { padding: 12px 24px; background: rgb(249, 250, 251); text-align: center; border-radius: 0px 0px 0px 20px; flex-shrink: 0; }

@media (prefers-color-scheme: dark) {
  .delve-settings-footer { background: rgb(20, 20, 20); }
}

.delve-settings-brand { display: flex; align-items: center; justify-content: center; gap: 6px; }

.delve-settings-brand-text { font-size: 0.6875rem; color: rgb(156, 163, 175); }

@media (prefers-color-scheme: dark) {
  .delve-settings-brand-text { color: rgb(107, 114, 128); }
}

.delve-brand-footer { padding: 16px 24px; background: rgb(249, 250, 251); text-align: center; border-radius: 0px 0px 0px 20px; }

@media (prefers-color-scheme: dark) {
  .delve-brand-footer { background: rgb(20, 20, 20); }
}

.delve-brand-content { display: flex; align-items: center; justify-content: center; gap: 8px; }

.delve-brand-logo { width: 80px; height: 24px; flex-shrink: 0; display: inline-block; vertical-align: middle; margin-left: 2px; margin-bottom: 1px; }

.delve-brand-logo img { width: 100%; height: 100%; object-fit: contain; vertical-align: middle; }

.delve-brand-logo svg { width: 80px; height: 24px; fill: currentcolor; vertical-align: middle; }

.delve-brand-text { font-size: 0.75rem; color: rgb(156, 163, 175); }

@media (prefers-color-scheme: dark) {
  .delve-brand-text { color: rgb(107, 114, 128); }
}

.delve-brand-link { color: rgb(59, 130, 246); text-decoration: none; }

@media (prefers-color-scheme: dark) {
  .delve-brand-link { color: rgb(255, 255, 255); }
}

.delve-brand-link:hover { text-decoration: underline; }

@media (max-width: 768px) {
  .delve-cookie-banner { bottom: 12px; left: 12px; right: 12px; transform: translateY(100px); max-width: none; width: auto; border-radius: 1.75rem; padding: 16px; }
  .delve-cookie-banner.show { transform: translateY(0px); }
  .delve-cookie-banner.hiding { transform: translateY(120px); opacity: 0; pointer-events: none; visibility: hidden; }
  .delve-banner-content { gap: 16px; }
  .delve-banner-title { font-size: 1.125rem; }
  .delve-banner-message { font-size: 0.8125rem; line-height: 1.4; }

.animate-\[heartbeat_1s_ease-in-out\] { animation: 1s ease-in-out 0s 1 normal none running heartbeat; }

@keyframes bounce { 
  0%, 100% { transform: translateY(-25%); animation-timing-function: cubic-bezier(0.8, 0, 1, 1); }
  50% { transform: none; animation-timing-function: cubic-bezier(0, 0, 0.2, 1); }
}

.animate-bounce { animation: 1s ease 0s infinite normal none running bounce; }

@keyframes gradient { 
  0% { background-position: 100% 50%; }
  50% { background-position: 50% 50%; }
  100% { background-position: 0px 50%; }
}

.animate-gradient { animation: 6s ease-in-out 0s infinite normal none running gradient; }

@keyframes message-highlight { 
  0% { opacity: 0.5; }
  100% { opacity: 1; }
}

.animate-message-highlight { animation: 0.4s ease-in-out 0s 3 normal none running message-highlight; }

@keyframes ping { 
  75%, 100% { transform: scale(2); opacity: 0; }
}

.animate-ping { animation: 1s cubic-bezier(0, 0, 0.2, 1) 0s infinite normal none running ping; }

@keyframes pulse { 
  50% { opacity: 0.5; }
}

.animate-pulse { animation: 2s cubic-bezier(0.4, 0, 0.6, 1) 0s infinite normal none running pulse; }

@keyframes spin { 
  100% { transform: rotate(1turn); }
}

.animate-spin { animation: 1s linear 0s infinite normal none running spin; }

@keyframes text-shimmer { 
  0% { background-position: 200% 50%; }
  100% { background-position: -100% 50%; }
}

.animate-text-shimmer { animation: 2s ease-in-out 0s infinite normal none running text-shimmer; }


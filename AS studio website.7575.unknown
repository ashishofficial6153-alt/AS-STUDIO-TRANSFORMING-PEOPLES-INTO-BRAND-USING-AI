.delve-banner-brand { display: flex; align-items: center; justify-content: center; gap: 4px; }

.delve-banner-brand-text { font-size: 0.6875rem; color: rgb(156, 163, 175); }

.delve-banner-brand-logo { width: 60px; height: 18px; flex-shrink: 0; display: inline-block; vertical-align: middle; margin-left: 1px; margin-top: -3px; }

.delve-banner-brand-logo img { width: 100%; height: 100%; object-fit: contain; vertical-align: middle; }

.delve-banner-brand-logo svg { width: 60px; height: 18px; fill: currentcolor; vertical-align: middle; }

.delve-banner-brand-link { color: rgb(59, 130, 246); text-decoration: none; }

@media (prefers-color-scheme: dark) {
  .delve-banner-brand-link { color: rgb(255, 255, 255); }
}

.delve-banner-brand-link:hover { text-decoration: underline; }

.delve-btn { padding: 0.625rem 0.875rem; border: none; border-radius: 20px; font-size: 0.8125rem; font-weight: 500; cursor: pointer; transition: background-color 0.3s, box-shadow 0.3s; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; white-space: nowrap; min-height: 2.25rem; width: 100%; outline: none; }

.delve-btn:focus-visible { outline: rgb(59, 130, 246) solid 2px; outline-offset: 2px; }

.delve-btn-primary { background: rgb(27, 27, 27); color: white; border: none; }

.delve-btn-primary:hover { background: rgb(56, 56, 56); box-shadow: rgba(0, 0, 0, 0.15) 0px 2px 8px; }

@media (prefers-color-scheme: dark) {
  .delve-btn-primary { background: rgb(255, 255, 255); color: rgb(27, 27, 27); border: none; }

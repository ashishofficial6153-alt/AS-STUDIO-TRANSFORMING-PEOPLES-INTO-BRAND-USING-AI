::-webkit-input-placeholder { color: rgb(163, 169, 172); font-weight: 500; }

.modalContainer { position: absolute; top: 0px; left: 0px; width: 100%; min-height: 100%; overflow: hidden auto; box-sizing: border-box; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol"; font-size: 14px; line-height: 1.5; display: flex; -webkit-box-orient: vertical; -webkit-box-direction: normal; flex-direction: column; -webkit-box-align: center; align-items: center; z-index: 99999; }

.modalContainer::before { content: ""; display: block; position: fixed; inset: 0px; background-color: rgb(255, 255, 255); z-index: -1; }

.modalDialog { -webkit-box-flex: 1; flex-grow: 1; display: flex; -webkit-box-orient: vertical; -webkit-box-direction: normal; flex-direction: column; width: 100%; }

.modalContent { position: relative; padding: 32px; opacity: 0; transform: translateY(10px) scale(1); background: rgb(255, 255, 255); }

[aria-hidden="false"] .modalContent { animation: 0.2s cubic-bezier(0.18, 0.89, 0.32, 1.28) 0s 1 normal forwards running bouncyEntrance; }

@-webkit-keyframes bouncyEntrance { 
  0% { opacity: 0; transform: translateY(10px) scale(0.9); }
  100% { opacity: 1; transform: translateY(0px) scale(1); }
}

@keyframes bouncyEntrance { 
  0% { opacity: 0; transform: translateY(10px) scale(0.9); }
  100% { opacity: 1; transform: translateY(0px) scale(1); }
}

@media (min-width: 480px) {
  .modalContainer::before { background-color: rgb(14, 30, 37); animation: 0.1s ease-in 0s 1 normal forwards running fadeIn; }
  .modalDialog { max-width: 364px; -webkit-box-pack: center; justify-content: center; }
  .modalContent { background: rgb(255, 255, 255); box-shadow: rgba(0, 0, 0, 0.07) 0px 4px 12px 0px, rgba(14, 30, 37, 0.1) 0px 12px 32px 0px; border-radius: 8px; margin-top: 32px; }
}

@-webkit-keyframes fadeIn { 
  0% { opacity: 0; }
  100% { opacity: 0.67; }
}

@keyframes fadeIn { 
  0% { opacity: 0; }
  100% { opacity: 0.67; }
}

.flashMessage { text-align: center; color: rgb(14, 30, 37); font-weight: 500; font-size: 14px; background-color: rgb(242, 243, 243); padding: 6px; border-radius: 4px; opacity: 0.7; transition: opacity 0.2s linear; }

.flashMessage:hover, .flashMessage:focus { opacity: 1; }

.error { color: rgb(250, 57, 70); background-color: rgb(252, 238, 240); opacity: 1; }

.error span::before { content: ""; display: inline-block; position: relative; top: 3px; margin-right: 4px; width: 16px; height: 16px; background: url("data:image/svg+xml;base64,") center center no-repeat; }

.success { }

.disabled { opacity: 0.38; pointer-events: none; }

.infoText { text-align: center; margin: 32px 0px; }

.infoTextEmail { font-size: 16px; font-weight: 500; }

.saving { background-image: url("data:image/png;base64,"); background-repeat: repeat-x; background-size: contain; background-origin: border-box; background-position: 0% 0%; animation: 20s linear 0s infinite normal none running loading; pointer-events: none; }

.saving::after { content: "â€¦"; }

@-webkit-keyframes loading { 
  0% { background-position: 0% 0%; }
  100% { background-position: 700% 0%; }
}

@keyframes loading { 
  0% { background-position: 0% 0%; }
  100% { background-position: 700% 0%; }
}

.btn { display: block; position: relative; width: 100%; height: auto; margin: 14px 0px 0px; padding: 6px; outline: 0px; cursor: pointer; border: 2px solid rgb(14, 30, 37); border-radius: 4px; background-color: rgb(45, 59, 65); color: rgb(255, 255, 255); transition: background-color 0.2s; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol"; font-size: 14px; font-weight: 500; line-height: 24px; text-align: center; text-decoration: none; white-space: nowrap; }

.btn:hover, .btn:focus { background-color: rgb(14, 30, 37); text-decoration: none; }

.btnClose { position: absolute; top: 0px; right: 0px; padding: 0px; border: 0px; width: 24px; height: 24px; border-radius: 50%; margin: 6px; background: rgb(255, 255, 255); color: rgb(163, 169, 172); }

.btnClose::before { content: "Ã—"; font-size: 25px; line-height: 9px; }

.btnClose:hover, .btnClose:focus { background: rgb(233, 235, 235); color: rgb(14, 30, 37); }

.header { display: flex; margin-top: -8px; margin-bottom: 32px; }

.btnHeader { font-size: 16px; line-height: 24px; background: rgb(255, 255, 255); color: rgb(163, 169, 172); border-width: 0px 0px 2px; border-top-style: initial; border-right-style: initial; border-left-style: initial; border-top-color: initial; border-right-color: initial; border-left-color: initial; border-image: initial; border-bottom-style: solid; border-bottom-color: rgb(233, 235, 235); border-radius: 4px 4px 0px 0px; margin: 0px; }

.btnHeader:focus, .btnHeader.active { background: rgb(255, 255, 255); color: rgb(14, 30, 37); border-color: rgb(14, 30, 37); font-weight: 700; }

.btnHeader:not(:only-child):hover { background-color: rgb(233, 235, 235); color: rgb(14, 30, 37); }

.btnHeader:only-child { cursor: auto; }

.btnLink { display: block; position: relative; width: auto; height: auto; margin: 14px auto 0px; padding: 6px 6px 0px; outline: 0px; cursor: pointer; color: rgb(14, 30, 37); border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 2px solid rgb(233, 235, 235); border-radius: 0px; background-color: inherit; transition: border-color 0.2s; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol"; font-size: 14px; font-weight: 500; line-height: 24px; text-align: center; white-space: nowrap; }

.btnLink:hover, .btnLink:focus { background-color: inherit; border-color: rgb(163, 169, 172); }

.form { }

.formGroup { position: relative; margin-top: 14px; }

.formControl { box-sizing: border-box; display: block; width: 100%; height: 40px; margin: 0px; padding: 6px 12px 6px 34px; border: 2px solid rgb(233, 235, 235); border-radius: 4px; background: rgb(255, 255, 255); color: rgb(14, 30, 37); box-shadow: none; font-size: 16px; font-weight: 500; line-height: 24px; transition: box-shadow 0.15s ease-in-out, -webkit-box-shadow 0.15s ease-in-out; appearance: none; }

.inputFieldIcon { position: absolute; top: 12px; left: 12px; display: inline-block; width: 16px; height: 16px; background-repeat: no-repeat; background-position: center center; pointer-events: none; }

.inputFieldName { background-image: url("data:image/svg+xml;base64,"); }

.inputFieldEmail { background-image: url("data:image/svg+xml;base64,"); }

.inputFieldPassword { background-image: url("data:image/svg+xml;base64,"); }

.inputFieldUrl { background-image: url("data:image/svg+xml;base64,"); }

.formLabel { }

.hr { border-width: 2px 0px 0px; border-right-style: initial; border-bottom-style: initial; border-left-style: initial; border-right-color: initial; border-bottom-color: initial; border-left-color: initial; border-image: initial; border-top-style: solid; border-top-color: rgb(233, 235, 235); margin: 32px 0px -1px; text-align: center; overflow: visible; }

.hr::before { content: "or"; position: relative; display: inline-block; font-size: 12px; font-weight: 800; line-height: 1; text-transform: uppercase; background-color: rgb(255, 255, 255); color: rgb(14, 30, 37); padding: 4px; top: -11px; }

.btnProvider { padding-left: 40px; padding-right: 40px; }

.btnProvider::before { content: ""; position: absolute; display: inline-block; vertical-align: middle; width: 32px; height: 40px; background-repeat: no-repeat; background-position: left center; top: -2px; left: 14px; }

.providerGoogle { background-color: rgb(66, 133, 244); border-color: rgb(54, 109, 199); }

.providerGoogle:hover, .providerGoogle:focus { background-color: rgb(54, 109, 199); }

.providerGitHub { background-color: rgb(51, 51, 51); border-color: rgb(0, 0, 0); }

.providerGitHub:hover, .providerGitHub:focus { background-color: rgb(0, 0, 0); }

.providerGitLab { background-color: rgb(226, 67, 41); border-color: rgb(176, 51, 32); }

.providerGitLab:hover, .providerGitLab:focus { background-color: rgb(176, 51, 32); }

.providerBitbucket { background-color: rgb(32, 80, 129); border-color: rgb(20, 49, 79); }

.providerBitbucket:hover, .providerBitbucket:focus { background-color: rgb(20, 49, 79); }

.providerGoogle::before { background-image: url("data:image/svg+xml;base64,"); }

.providerGitHub::before { background-image: url("data:image/svg+xml;base64,"); }

.providerGitLab::before { background-image: url("data:image/svg+xml;base64,"); }

.providerBitbucket::before { background-image: url("data:image/svg+xml;base64,"); }

.callOut { display: block; padding: 32px; font-size: 14px; font-weight: 500; text-decoration: none; color: rgb(163, 169, 172); text-align: center; }

.callOut::after { content: " â™¥"; transition: color 4s; }

.callOut:hover::after { color: red; }

.callOut .netlifyLogo { display: block; margin: auto auto 8px; width: 32px; height: 32px; background-image: url("data:image/svg+xml;base64,"); }

.visuallyHidden { border: 0px; clip: rect(0px, 0px, 0px, 0px); height: 1px; margin: -1px; overflow: hidden; padding: 0px; position: absolute; width: 1px; white-space: nowrap; }

.subheader { margin-top: 2em; border-top: 1px solid rgb(14, 30, 37); }

.subheader h3 { padding-top: 1em; text-align: center; }
